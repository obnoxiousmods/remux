diff --git a/tests/slskd.Tests.Unit/Common/ApiConcurrencyTests.cs b/tests/slskd.Tests.Unit/Common/ApiConcurrencyTests.cs
new file mode 100644
index 0000000..e984ed0
--- /dev/null
+++ b/tests/slskd.Tests.Unit/Common/ApiConcurrencyTests.cs
@@ -0,0 +1,38 @@
+using System;
+using System.Threading;
+using System.Threading.Tasks;
+using Xunit;
+
+namespace slskd.Tests.Unit.Common;
+
+public class ApiConcurrencyTests
+{
+    [Fact]
+    public async Task CancelledRequestDoesNotAcquireALimiterSlot()
+    {
+        using var semaphore = ApiConcurrency.CreateLimiter(1);
+        using var cancellation = new CancellationTokenSource();
+        cancellation.Cancel();
+
+        await Assert.ThrowsAnyAsync<OperationCanceledException>(async () =>
+            await ApiConcurrency.TryAcquireAsync(semaphore, cancellation.Token));
+
+        Assert.True(await ApiConcurrency.TryAcquireAsync(semaphore));
+    }
+
+    [Theory]
+    [InlineData(1)]
+    [InlineData(2)]
+    [InlineData(16)]
+    public async Task LimitIsEnforcedAndReleasedSlotsAreReusable(int limit)
+    {
+        using var semaphore = ApiConcurrency.CreateLimiter(limit);
+        for (var i = 0; i < limit; i++)
+        {
+            Assert.True(await ApiConcurrency.TryAcquireAsync(semaphore));
+        }
+        Assert.False(await ApiConcurrency.TryAcquireAsync(semaphore));
+        semaphore.Release();
+        Assert.True(await ApiConcurrency.TryAcquireAsync(semaphore));
+    }
+}
