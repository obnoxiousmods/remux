+namespace slskd
+{
+    using System;
+    using System.Threading;
+    using System.Threading.Tasks;
+
+    /// <summary>
+    ///     Concurrency limits for the API endpoints that broker Soulseek peer
+    ///     operations.
+    /// </summary>
+    /// <remarks>
+    ///     <para>
+    ///         The upstream defaults serialise these endpoints — two concurrent
+    ///         download requests and a single concurrent search — and reject the
+    ///         overflow immediately with HTTP 429 rather than queueing it. That is
+    ///         a sensible default for a human clicking in the web UI, but it caps
+    ///         an automated client that wants to request the same file from several
+    ///         peers at once and keep whichever peer starts sending first.
+    ///     </para>
+    ///     <para>
+    ///         Soulseek peer latency is wildly variable — measured time-to-first-byte
+    ///         for the same track ranged from 1.3 s to 11 s across peers — so racing
+    ///         peers can reduce cold acquisition latency; it does not guarantee
+    ///         sub-second playback. Serialising the requests turns a
+    ///         parallel race into a sequential walk and throws away that win.
+    ///     </para>
+    ///     <para>
+    ///         Limits are read from the environment so that this behaviour is opt-in
+    ///         per deployment and the configuration file schema is untouched.
+    ///     </para>
+    /// </remarks>
+    public static class ApiConcurrency
+    {
+        /// <summary>
+        ///     Gets the number of download requests that may be in flight at once.
+        /// </summary>
+        public static int DownloadRequests { get; } =
+            ReadEnvironmentInt("SLSKD_API_DOWNLOAD_CONCURRENCY", defaultValue: 2, min: 1, max: 256);
+
+        /// <summary>
+        ///     Gets the number of searches that may be in flight at once.
+        /// </summary>
+        public static int SearchRequests { get; } =
+            ReadEnvironmentInt("SLSKD_API_SEARCH_CONCURRENCY", defaultValue: 1, min: 1, max: 64);
+
+        /// <summary>
+        ///     Gets how long a request waits for a slot before it is rejected.
+        /// </summary>
+        /// <remarks>
+        ///     Upstream rejects instantly. A short wait converts a burst that would
+        ///     otherwise 429 into a brief queue, which is what a client racing peers
+        ///     actually wants — and it still fails fast rather than hanging.
+        /// </remarks>
+        public static TimeSpan AcquireTimeout { get; } = TimeSpan.FromMilliseconds(
+            ReadEnvironmentInt("SLSKD_API_CONCURRENCY_WAIT_MS", defaultValue: 0, min: 0, max: 30000));
+
+        /// <summary>
+        ///     Creates a semaphore with the given limit.
+        /// </summary>
+        /// <param name="limit">The maximum number of concurrent holders.</param>
+        /// <returns>The semaphore.</returns>
+        public static SemaphoreSlim CreateLimiter(int limit) => new SemaphoreSlim(limit, limit);
+
+        /// <summary>
+        ///     Attempts to acquire a slot from <paramref name="limiter"/>, waiting up
+        ///     to <see cref="AcquireTimeout"/>.
+        /// </summary>
+        /// <param name="limiter">The semaphore to acquire.</param>
+        /// <param name="cancellationToken">Cancellation for a disconnected API caller.</param>
+        /// <returns>A value indicating whether a slot was acquired.</returns>
+        public static Task<bool> TryAcquireAsync(SemaphoreSlim limiter, CancellationToken cancellationToken = default)
+        {
+            cancellationToken.ThrowIfCancellationRequested();
+
+            return AcquireTimeout == TimeSpan.Zero
+                ? Task.FromResult(limiter.Wait(0))
+                : limiter.WaitAsync(AcquireTimeout, cancellationToken);
+        }
+
+        private static int ReadEnvironmentInt(string name, int defaultValue, int min, int max)
+        {
+            var raw = Environment.GetEnvironmentVariable(name);
+
+            if (string.IsNullOrWhiteSpace(raw) || !int.TryParse(raw.Trim(), out var value))
+            {
+                return defaultValue;
+            }
+
+            return Math.Clamp(value, min, max);
+        }
+    }
+}
